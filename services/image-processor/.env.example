# Keep this file outside the public app and never commit real secrets.
METTI_PROCESSOR_API_KEY=replace-with-a-long-random-secret
METTI_PROCESSOR_ALLOW_ANONYMOUS=false

# grounding_dino_sam2 is the production path. It grounds the wardrobe
# category in the photo before SAM2 cuts the object out. rembg is a generic
# prototype only, and grounded_sam2 remains as the legacy YOLO-World adapter.
METTI_PROCESSOR_BACKEND=grounding_dino_sam2
METTI_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
METTI_SAM_MODEL=/models/sam2_b.pt
METTI_MATTING_MODEL=u2net
METTI_MATTING_ENABLED=true

METTI_PROCESSOR_MAX_INPUT_BYTES=5242880
METTI_PROCESSOR_MAX_PIXELS=20000000
METTI_PROCESSOR_MAX_OUTPUT_BYTES=8388608
