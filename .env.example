# Supabase project values. Never commit a service_role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional MCP hardening. Empty values allow normal HTTPS MCP clients.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=
MCP_RATE_LIMIT_PER_MINUTE=120
# 8 MiB permits one MCP JSON request containing a base64 image capped at 5 MiB.
MCP_MAX_BODY_BYTES=8388608
# Exact HTTPS hosts allowed for server-side MCP resource downloads. Empty means
# remote image resources fall back to imageStatus=pending; inline MCP images
# (image/resource blob) do not need a host allowlist.
MCP_ALLOWED_IMAGE_HOSTS=
# OpenAI/ChatGPT temporary file hosts used by the top-level MCP file parameter.
MCP_OPENAI_FILE_HOSTS=files.openai.com,*.files.openai.com,*.oaiusercontent.com,*.chatgpt.com
MCP_IMAGE_MAX_BYTES=5242880
MCP_IMAGE_FETCH_TIMEOUT_MS=10000
MCP_ALLOW_HTTP_IMAGE_RESOURCES=false

# Optional override for the backend-owned wardrobe segmentation/matting
# service. The deployed Metti Supabase functions use the Cloudflare adapter
# by default; set this only to replace it with a private compatible endpoint.
# The endpoint must accept multipart/form-data and return a transparent PNG
# cutout plus quality metrics (see docs/IMAGE_PROCESSING.md).
METTI_IMAGE_PROCESSOR_URL=
METTI_IMAGE_PROCESSOR_API_KEY=
METTI_IMAGE_PROCESSOR_TIMEOUT_MS=60000
METTI_IMAGE_PROCESSOR_MAX_OUTPUT_BYTES=8388608

# The following variables belong to the private image-processor container,
# not to the Supabase Edge Function. See services/image-processor/.env.example.
