# Supabase project values. Never commit a service_role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional MCP hardening. Empty values allow normal HTTPS MCP clients.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_MAX_BODY_BYTES=131072
